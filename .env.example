# Copia este archivo a .env y rellena los valores. .env NUNCA se sube a git.

# --- PostgreSQL (docker-compose.yml y backend) ---
POSTGRES_DB=supermercado
POSTGRES_USER=supermercado
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- JWT (Fase 2) ---
# Clave HS256 de al menos 256 bits. Genérala con:  openssl rand -base64 48
JWT_SECRET=

# --- Correo ("¿Has olvidado tu contraseña?") ---
# Servidor SMTP con el que se envían los enlaces. Sin MAIL_HOST no se envía nada y el enlace
# aparece en el log del backend (suficiente para probar en local).
# Quita el "# " al rellenarlas: una variable vacía (VAR=) anula el valor por defecto de Spring.
# Con Gmail: activa la verificación en 2 pasos y crea una "contraseña de aplicación" en
# myaccount.google.com/apppasswords (16 letras; NO es tu contraseña normal).
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=tucuenta@gmail.com
# MAIL_PASSWORD=
# Remitente; por defecto MAIL_USERNAME (con Gmail tiene que ser esa misma dirección)
# MAIL_FROM=

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Producción (docker-compose.prod.yml) ---
# Dominio que apunta a tu servidor (registro DNS tipo A) y la URL pública completa
# DOMAIN=tudominio.com
# PUBLIC_URL=https://tudominio.com

# Copias de seguridad automáticas (servicio "backup"): cada cuántas horas y cuántas se guardan
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
