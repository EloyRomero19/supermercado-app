# Copia este archivo a .env y rellena los valores. .env NUNCA se sube a git.

# --- PostgreSQL (docker-compose.yml y backend) ---
POSTGRES_DB=supermercado
POSTGRES_USER=supermercado
POSTGRES_PASSWORD=
POSTGRES_PORT=5432

# --- JWT (Fase 2) ---
# Clave HS256 de al menos 256 bits. Genérala con:  openssl rand -base64 48
JWT_SECRET=

# --- Frontend ---
FRONTEND_URL=http://localhost:5173

# --- Producción (docker-compose.prod.yml) ---
# Dominio que apunta a tu servidor (registro DNS tipo A) y la URL pública completa
# DOMAIN=tudominio.com
# PUBLIC_URL=https://tudominio.com

# Copias de seguridad automáticas (servicio "backup"): cada cuántas horas y cuántas se guardan
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14
