# Imagen del backend para Vercel. Vercel apaga el contenedor tras 5 min sin peticiones y lo vuelve
# a arrancar con la siguiente, en 1 CPU: lo que importa aquí es ARRANCAR RÁPIDO.
# Medido con 1 CPU: el Dockerfile normal tarda ~40 s en arrancar; esta imagen, ~8 s.
#
# Variables en Vercel (Settings → Environment Variables): PORT=8080, POSTGRES_*, JWT_SECRET,
# FRONTEND_URL y, para los correos de "¿Has olvidado tu contraseña?", MAIL_* (ver .env.example).

# --- Etapa 1: compilar con el JDK y Maven (igual que el Dockerfile normal) ---
FROM eclipse-temurin:21-jdk-alpine AS build
WORKDIR /app
COPY .mvn/ .mvn/
COPY mvnw pom.xml ./
RUN ./mvnw -q -B dependency:go-offline
COPY src/ src/
RUN ./mvnw -q -B -DskipTests package && cp target/backend-*.jar app.jar

# --- Etapa 2: "entrenar" la caché AOT de Java 25 ---
# Se arranca la app una vez aquí, al construir la imagen, y la JVM guarda en app.aot las clases ya
# cargadas y enlazadas. Al arrancar de verdad las lee de ahí en vez de repetir ese trabajo.
# (El código compilado con Java 21 funciona igual en Java 25.)
FROM eclipse-temurin:25-jre-alpine AS aot
WORKDIR /app
COPY --from=build /app/app.jar app.jar
# La caché AOT necesita el .jar "desempaquetado" (las dependencias como .jar sueltos en lib/)
RUN java -Djarmode=tools -jar app.jar extract --destination extracted
WORKDIR /app/extracted
# spring.context.exit=onRefresh: arranca Spring y sale. Al construir no hay base de datos, así que se
# desactivan Flyway y las comprobaciones contra ella; las claves son de mentira y no llegan a la imagen.
# Las opciones de la JVM (GC, JIT) tienen que ser las mismas que en el ENTRYPOINT.
RUN java -XX:AOTCacheOutput=app.aot -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -Xlog:aot*=error \
      -Dspring.context.exit=onRefresh \
      -Dspring.flyway.enabled=false \
      -Dspring.jpa.hibernate.ddl-auto=none \
      -Dspring.jpa.properties.hibernate.boot.allow_jdbc_metadata_access=false \
      -Dspring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect \
      -DJWT_SECRET=c29sby1wYXJhLWVudHJlbmFyLWxhLWNhY2hlLWFvdC1uby1lcy11bmEtY2xhdmUtcmVhbA \
      -DPOSTGRES_PASSWORD=sin-base-de-datos \
      -jar app.jar

# --- Etapa 3: solo el JRE, la app y su caché ---
FROM eclipse-temurin:25-jre-alpine
RUN addgroup -S app && adduser -S app -G app
WORKDIR /app
COPY --from=aot /app/extracted/ ./
USER app
EXPOSE 8080
# - AOTCache: la caché de la etapa 2. Si la JVM no pudiera usarla, arranca igual (más despacio).
# - UseSerialGC y TieredStopAtLevel=1: con 1 CPU, el recolector de basura en paralelo y el
#   compilador optimizador (C2) le roban la CPU al arranque. Esta app pasa casi todo el tiempo
#   esperando a la base de datos, así que el código "menos optimizado" no se nota.
# - Xlog:aot*=error: sin avisos informativos de la caché en los logs de Vercel.
ENTRYPOINT ["java", "-XX:AOTCache=app.aot", "-XX:+UseSerialGC", "-XX:TieredStopAtLevel=1", "-Xlog:aot*=error", "-XX:MaxRAMPercentage=75", "-jar", "app.jar"]
