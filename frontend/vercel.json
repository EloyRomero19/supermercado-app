{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://supermercado-app-backend.vercel.app/api/:path*" },
    { "source": "/oauth2/:path*", "destination": "https://supermercado-app-backend.vercel.app/oauth2/:path*" },
    { "source": "/login/oauth2/:path*", "destination": "https://supermercado-app-backend.vercel.app/login/oauth2/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}